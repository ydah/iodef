module Iodef
  VERSION: String
  DEFAULT_LIMITS: Hash[Symbol, Integer]
  SCHEMA: Hash[String, untyped]
  ENUMS: Hash[String, Array[String]]
  MAPKEYS: Hash[String, Integer]
  KEYNAMES: Hash[Integer, String]

  def self.parse: (String source, ?strict: bool, ?validate: bool, **Integer limits) -> Document
  def self.parse_cbor: (String source, ?strict: bool, ?validate: bool, **Integer limits) -> Document
  def self.parse_xml: (String source, ?strict: bool, ?validate: bool, **Integer limits) -> Document
  def self.validate: (untyped source, **Integer limits) -> Array[Violation]
  def self.generate_json: (untyped value, ?untyped options) -> String
  def self.pointer: (String parent, untyped key) -> String

  class Violation
    attr_reader pointer: String
    attr_reader rule: String
    attr_reader message: String
    def self.new: (pointer: String, rule: String, message: String) -> instance
  end
  class Error < StandardError
  end
  class ParseError < Error
  end
  class ConversionError < Error
  end
  class ValidationError < Error
    attr_reader pointer: String
    attr_reader violations: Array[Violation]
    def initialize: (?String message, ?pointer: String, ?violations: Array[Violation]) -> void
  end
  class LimitError < ValidationError
  end
  class Validator
    attr_reader limits: Hash[Symbol, Integer]
    def initialize: (**Integer limits) -> void
    def validate: (untyped value, ?type: String) -> Array[Violation]
  end
  class Model
    attr_reader limits: Hash[Symbol, Integer]
    attr_reader warnings: Array[Violation]
    def initialize: (?Hash[untyped, untyped] data, ?strict: bool, **Integer limits) -> void
    def []: (String | Symbol key) -> untyped
    def []=: (String | Symbol key, untyped value) -> untyped
    def delete: (String | Symbol key) -> untyped
    def to_h: () -> Hash[String, untyped]
    def to_json: (?untyped options) -> String
    def validate!: () -> self
    def description: () -> MultilingualText
    def description=: (Array[untyped] value) -> untyped
  end
  class MultilingualText
    include Enumerable[untyped]
    def initialize: (untyped values, ?lang: String?) -> void
    def each: () { (untyped) -> untyped } -> Array[untyped]
            | () -> Enumerator[untyped, Array[untyped]]
    def text: (?String? language) -> String?
    def to_a: () -> Array[untyped]
  end
  class Document < Model
    def self.build: (?lang: String?, **Integer limits) { (Document) -> untyped } -> Document
    def incidents: () -> Array[Incident]
    def add_incident: (purpose: String, **untyped attributes) ?{ (Incident) -> untyped } -> Incident
    def to_cbor: () -> String
    def to_xml: () -> String
  end
  class Incident < Model
    def contacts: () -> Array[Contact]
    def assessments: () -> Array[Assessment]
    def indicators: () -> Array[Indicator]
    def add_contact: (role: String, type: String, **untyped attributes) ?{ (Contact) -> untyped } -> Contact
  end
  class Contact < Model
  end
  class Assessment < Model
  end
  class EventData < Model
  end
  class Indicator < Model
  end
end
module IODEF = Iodef

module Iodef
