    def method=: (untyped value) -> untyped
    def contact: () -> (Array[Contact])?
    def contact=: (untyped value) -> untyped
    def event_data: () -> (Array[EventData])?
    def event_data=: (untyped value) -> untyped
    def indicator: () -> (Array[Indicator])?
    def indicator=: (untyped value) -> untyped
    def history: () -> (Hash[String, untyped])?
    def history=: (untyped value) -> untyped
  end
  class Contact < Model
    def restriction: () -> (String)?
